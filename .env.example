# Application
NODE_ENV=development
PORT=3000

# AI Provider
# Supported: mock, openai
AGENT_PROVIDER=mock
OPENAI_MODEL=gpt-4.1-mini

# Required only when AGENT_PROVIDER=openai
OPENAI_API_KEY=

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=agentmacarthur
DB_TEST_NAME=agentmacarthur_test

# CORS
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:4200,http://localhost:5173

# Database query timeout (milliseconds)
DB_QUERY_TIMEOUT_MS=30000

# Slow database operation warning threshold (milliseconds)
DB_SLOW_QUERY_THRESHOLD_MS=1000
